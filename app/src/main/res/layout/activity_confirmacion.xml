<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/gradient_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <!-- Animación de confeti musical -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_music_note"
                    android:tint="#9C4DFF"
                    android:rotation="-15"
                    android:layout_marginHorizontal="5dp" />

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ic_music_note"
                    android:tint="#5E35B1"
                    android:rotation="10"
                    android:layout_marginHorizontal="5dp" />

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_music_note"
                    android:tint="#BB86FC"
                    android:rotation="20"
                    android:layout_marginHorizontal="5dp" />

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ic_music_note"
                    android:tint="#7C4DFF"
                    android:rotation="-10"
                    android:layout_marginHorizontal="5dp" />

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_music_note"
                    android:tint="#AA00FF"
                    android:rotation="5"
                    android:layout_marginHorizontal="5dp" />
            </LinearLayout>

            <!-- Círculo de éxito con check -->
            <LinearLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/circle_success_background"
                android:gravity="center"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:src="@drawable/ic_check_circle"
                    android:tint="#FFFFFF" />
            </LinearLayout>

            <!-- Tarjeta de confirmación -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="8dp"
                app:cardCornerRadius="30dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#1E1E1E"
                app:strokeColor="#9C4DFF"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="30dp">

                    <!-- Título de éxito -->
                    <TextView
                        android:text="¡Registro Exitoso! 🎵"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="#9C4DFF"
                        android:gravity="center"
                        android:layout_marginBottom="24dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Subtítulo -->
                    <TextView
                        android:text="Bienvenido a HarmonyHub"
                        android:textSize="16sp"
                        android:textColor="#E0E0E0"
                        android:gravity="center"
                        android:layout_marginBottom="32dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Línea decorativa -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#9C4DFF"
                        android:layout_marginBottom="24dp" />

                    <!-- Datos del usuario con iconos -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/ic_person"
                            android:tint="#9C4DFF" />

                        <TextView
                            android:id="@+id/tvNombre"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:text="Nombre: "
                            android:textSize="18sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/ic_cake"
                            android:tint="#9C4DFF" />

                        <TextView
                            android:id="@+id/tvEdad"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:text="Edad: "
                            android:textSize="18sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="24dp">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/ic_music_note"
                            android:tint="#9C4DFF" />

                        <TextView
                            android:id="@+id/tvInstrumento"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:text="Instrumento: "
                            android:textSize="18sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Mensaje motivacional -->
                    <TextView
                        android:text="¡Prepárate para comenzar tu viaje musical!"
                        android:textSize="14sp"
                        android:textColor="#B0BEC5"
                        android:gravity="center"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="24dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Botones de acción -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_horizontal"
                        android:weightSum="2">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnVolver"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="Inicio"
                            android:textSize="16sp"
                            android:textColor="#FFFFFF"
                            android:textAllCaps="false"
                            app:cornerRadius="28dp"
                            app:icon="@drawable/ic_home"
                            app:iconGravity="textStart"
                            app:iconPadding="8dp"
                            app:backgroundTint="#5E35B1"
                            android:stateListAnimator="@null" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPerfil"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="Perfil"
                            android:textSize="16sp"
                            android:textColor="#FFFFFF"
                            android:textAllCaps="false"
                            app:cornerRadius="28dp"
                            app:icon="@drawable/ic_person"
                            app:iconGravity="textStart"
                            app:iconPadding="8dp"
                            app:backgroundTint="@color/button_gradient"
                            android:stateListAnimator="@null" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pie de página con iconos musicales -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_music_video"
                    android:tint="#757575"
                    android:layout_marginHorizontal="10dp" />

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_piano"
                    android:tint="#757575"
                    android:layout_marginHorizontal="10dp" />

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_library_music"
                    android:tint="#757575"
                    android:layout_marginHorizontal="10dp" />

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_headphones"
                    android:tint="#757575"
                    android:layout_marginHorizontal="10dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>