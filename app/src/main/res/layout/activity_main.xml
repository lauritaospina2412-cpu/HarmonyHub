<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/gradient_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <!-- Iconos musicales -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="40dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_music_note"
                    android:tint="#9C4DFF"
                    android:layout_marginHorizontal="8dp" />

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_music_note"
                    android:tint="#5E35B1"
                    android:rotation="15"
                    android:layout_marginHorizontal="8dp" />

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_music_note"
                    android:tint="#BB86FC"
                    android:layout_marginHorizontal="8dp" />

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_music_note"
                    android:tint="#7C4DFF"
                    android:rotation="-15"
                    android:layout_marginHorizontal="8dp" />

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_music_note"
                    android:tint="#AA00FF"
                    android:layout_marginHorizontal="8dp" />

            </LinearLayout>


            <!-- Logo -->
            <LinearLayout
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/circle_background"
                android:gravity="center"
                android:layout_marginTop="30dp">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_headphones"
                    android:tint="#FFFFFF" />

            </LinearLayout>


            <!-- Titulo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HarmonyHub"
                android:textSize="42sp"
                android:textStyle="bold"
                android:layout_marginTop="30dp"
                android:background="@drawable/gradient_text"
                android:paddingHorizontal="20dp"
                android:paddingVertical="5dp" />


            <!-- Subtitulo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tu viaje musical comienza aquí"
                android:textSize="18sp"
                android:textColor="#B0BEC5"
                android:layout_marginTop="15dp"
                android:fontFamily="sans-serif-light" />


            <!-- Card de características -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_marginHorizontal="16dp"
                app:cardElevation="8dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="#1E1E1E"
                app:strokeColor="#5E35B1"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tendrás acceso a:"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="16dp" />

                    <!-- Item -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_music_video"
                            android:tint="#9C4DFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="  Lecciones interactivas"
                            android:textSize="16sp"
                            android:textColor="#E0E0E0"
                            android:layout_marginStart="8dp" />

                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_piano"
                            android:tint="#7C4DFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="  Instrumentos virtuales"
                            android:textSize="16sp"
                            android:textColor="#E0E0E0"
                            android:layout_marginStart="8dp" />

                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_library_music"
                            android:tint="#5E35B1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="  Biblioteca musical"
                            android:textSize="16sp"
                            android:textColor="#E0E0E0"
                            android:layout_marginStart="8dp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- Botón -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEntrar"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="40dp"
                android:layout_marginHorizontal="16dp"
                android:text="Registrarse"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                app:cornerRadius="30dp"
                app:icon="@drawable/ic_music_note"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                android:elevation="8dp" />


            <!-- Login -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="30dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿Ya tienes cuenta? "
                    android:textColor="#B0BEC5"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inicia sesión"
                    android:textColor="#BB86FC"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>